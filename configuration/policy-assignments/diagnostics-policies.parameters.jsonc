{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "policyAssignments": {
      "value": [
        // Sends the diagnostic logs of resources to the Log Analytics workspace of their own region.
        // There is one assignment per region. The resourceLocationList parameter limits each assignment to the
        // resources of that region, which stream to the security workspace of the same region
        // (rg001 / log001 for West Europe, rg002 / log002 for Germany West Central).
        // Resources in a region that is not listed here do not get diagnostic settings from this initiative.
        {
          "TargetScope": "mg-contoso",
          // The assignment uses a system assigned managed identity to create the diagnostic settings.
          // This role is given to that identity: Log Analytics Contributor, the role the policies declare.
          "RoleDefinitionIds": [
            "92aaf0da-9dab-42b6-94a3-d43ce8d16293"
          ],
          "Assignment": {
            "AssignmentName": "contoso-diag-log-weu",
            "AssignmentDisplayName": "Contoso - Remediate diagnostic settings to the security Log Analytics workspace (West Europe)",
            "AssignmentDescription": "Streams the resource logs of the supported resource types in West Europe to the platform security Log Analytics workspace.",
            "AssignmentEnforcementMode": "Default",
            "AssignmentNonComplianceMessage": "Diagnostic settings for the platform security Log Analytics workspace are missing on this resource. The policy deploys them when the resource is created or updated, or through remediation.",
            "AssignmentPolicyId": "/providers/Microsoft.Management/managementGroups/mg-contoso/providers/Microsoft.Authorization/policySetDefinitions/contoso-deploy-diagnostics-log-analytics",
            "AssignmentParameters": {
              "logAnalytics": {
                "value": "/subscriptions/00000000-0000-0000-0000-000000000001/resourceGroups/sec-obs-prd-rg001/providers/Microsoft.OperationalInsights/workspaces/sec-obs-prd-log001"
              },
              "categoryGroup": {
                "value": "allLogs"
              },
              "resourceLocationList": {
                "value": [
                  "westeurope"
                ]
              }
            },
            "AssignmentIdentityType": "SystemAssigned",
            "AssignmentLocation": "westeurope"
          }
        },
        {
          "TargetScope": "mg-contoso",
          "RoleDefinitionIds": [
            "92aaf0da-9dab-42b6-94a3-d43ce8d16293"
          ],
          "Assignment": {
            "AssignmentName": "contoso-diag-log-gwc",
            "AssignmentDisplayName": "Contoso - Remediate diagnostic settings to the security Log Analytics workspace (Germany West Central)",
            "AssignmentDescription": "Streams the resource logs of the supported resource types in Germany West Central to the platform security Log Analytics workspace.",
            "AssignmentEnforcementMode": "Default",
            "AssignmentNonComplianceMessage": "Diagnostic settings for the platform security Log Analytics workspace are missing on this resource. The policy deploys them when the resource is created or updated, or through remediation.",
            "AssignmentPolicyId": "/providers/Microsoft.Management/managementGroups/mg-contoso/providers/Microsoft.Authorization/policySetDefinitions/contoso-deploy-diagnostics-log-analytics",
            "AssignmentParameters": {
              "logAnalytics": {
                "value": "/subscriptions/00000000-0000-0000-0000-000000000001/resourceGroups/sec-obs-prd-rg002/providers/Microsoft.OperationalInsights/workspaces/sec-obs-prd-log002"
              },
              "categoryGroup": {
                "value": "allLogs"
              },
              "resourceLocationList": {
                "value": [
                  "germanywestcentral"
                ]
              }
            },
            "AssignmentIdentityType": "SystemAssigned",
            "AssignmentLocation": "germanywestcentral"
          }
        }
      ]
    }
  }
}
